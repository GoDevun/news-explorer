# Register at https://newsapi.org/register to get a free API key,
# then copy this file to .env and paste your key below.
VITE_NEWS_API_KEY=REPLACE_WITH_YOUR_NEWS_API_KEY

# Register at https://finnhub.io/register for a free market data key,
# used by the Stock News Sentiment page for quotes, ratings and company news.
VITE_FINNHUB_API_KEY=REPLACE_WITH_YOUR_FINNHUB_API_KEY
