# Copy to backend/.env and fill in.

# Free key from https://www.marketaux.com/register
MARKETAUX_API_KEY=REPLACE_WITH_YOUR_MARKETAUX_KEY

# Signing secret for JWTs. Use a long random string in production.
JWT_SECRET=dev-secret-change-me

PORT=3001
MONGO_URL=mongodb://127.0.0.1:27017/stock-news-sentiment

# How long a scored feed stays fresh, and how long a stale copy is kept
# to serve when Marketaux is failing or the daily quota is spent.
CACHE_TTL_MS=900000
CACHE_STALE_MS=86400000
