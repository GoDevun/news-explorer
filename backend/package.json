{
  "name": "stock-news-sentiment-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST layer for the Stock News Sentiment Dashboard: normalizes, scores and caches Marketaux news, and persists saved tickers behind JWT auth.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "lint": "eslint src --ext js --max-warnings 0",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "celebrate": "^15.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
